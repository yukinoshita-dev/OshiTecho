<%= content_for :title, "#{@year}年 年間レポート | 推し手帳" %>

<%# ヘッダー %>
<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <div>
    <h1 class="text-2xl font-bold" style="font-family: var(--font-heading);">📊 <%= @year %>年 年間レポート</h1>
    <p class="text-sm mt-1" style="color: var(--color-text-muted);">推し活の1年を振り返ろう</p>
  </div>
  <div class="flex items-center gap-2 flex-wrap">
    <% @available_years.each do |y| %>
      <%= link_to y.to_s, annual_report_path(year: y),
            class: "tab-seal #{y == @year ? 'font-bold' : 'opacity-60'}" %>
    <% end %>
    <% unless @available_years.include?(Date.current.year) %>
      <%= link_to Date.current.year.to_s, annual_report_path, class: "tab-seal opacity-60" %>
    <% end %>
  </div>
</div>

<%# サマリーウィジェット %>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
  <div class="notebook-card text-center">
    <p class="text-3xl font-bold" style="color: var(--color-primary);"><%= @total_events %></p>
    <p class="text-xs mt-1" style="color: var(--color-text-muted);">参加イベント</p>
  </div>
  <div class="notebook-card text-center">
    <p class="text-xl font-bold" style="color: var(--color-primary);">¥<%= number_with_delimiter(@total_ticket_cost) %></p>
    <p class="text-xs mt-1" style="color: var(--color-text-muted);">チケット代</p>
  </div>
  <div class="notebook-card text-center">
    <p class="text-xl font-bold" style="color: var(--color-primary);">¥<%= number_with_delimiter(@total_goods_cost) %></p>
    <p class="text-xs mt-1" style="color: var(--color-text-muted);">グッズ費（<%= @total_goods_count %>点）</p>
  </div>
  <div class="notebook-card text-center">
    <p class="text-xl font-bold" style="color: var(--color-primary);">¥<%= number_with_delimiter(@total_cost) %></p>
    <p class="text-xs mt-1" style="color: var(--color-text-muted);">推し活合計</p>
  </div>
</div>

<%# 月別グラフ %>
<div class="notebook-card mb-6">
  <h2 class="font-bold ruled-line mb-4" style="font-family: var(--font-heading);">📅 月別イベント参加数</h2>
  <% max_count = @monthly_data.map { |d| d[:event_count] }.max.to_i %>
  <% max_count = 1 if max_count == 0 %>
  <div class="space-y-2">
    <% @monthly_data.each do |d| %>
      <div class="flex items-center gap-2 text-sm">
        <span class="w-8 text-right text-xs shrink-0" style="color: var(--color-text-muted);"><%= d[:month] %>月</span>
        <div class="flex-1 h-6 rounded relative" style="background: var(--color-surface);">
          <div class="h-full rounded transition-all"
               style="width: <%= (d[:event_count].to_f / max_count * 100).round(1) %>%; background: var(--color-primary); opacity: 0.7; min-width: <%= d[:event_count] > 0 ? '4px' : '0' %>;">
          </div>
        </div>
        <span class="w-8 text-xs shrink-0 text-right">
          <% if d[:event_count] > 0 %>
            <%= d[:event_count] %>回
          <% end %>
        </span>
      </div>
    <% end %>
  </div>
</div>

<%# 月別費用グラフ %>
<div class="notebook-card mb-6">
  <h2 class="font-bold ruled-line mb-4" style="font-family: var(--font-heading);">💴 月別出費</h2>
  <% max_cost = @monthly_data.map { |d| d[:ticket_cost] + d[:goods_cost] }.max.to_i %>
  <% max_cost = 1 if max_cost == 0 %>
  <div class="space-y-2">
    <% @monthly_data.each do |d| %>
      <% total_month_cost = d[:ticket_cost] + d[:goods_cost] %>
      <div class="flex items-center gap-2 text-sm">
        <span class="w-8 text-right text-xs shrink-0" style="color: var(--color-text-muted);"><%= d[:month] %>月</span>
        <div class="flex-1 h-6 rounded relative overflow-hidden" style="background: var(--color-surface);">
          <% ticket_pct = (d[:ticket_cost].to_f / max_cost * 100).round(1) %>
          <% goods_pct  = (d[:goods_cost].to_f / max_cost * 100).round(1) %>
          <div class="h-full flex">
            <div class="h-full" style="width: <%= ticket_pct %>%; background: var(--color-primary); opacity: 0.7;"></div>
            <div class="h-full" style="width: <%= goods_pct %>%; background: var(--color-accent, #f59e0b); opacity: 0.7;"></div>
          </div>
        </div>
        <span class="w-20 text-xs shrink-0 text-right" style="color: var(--color-text-muted);">
          <% if total_month_cost > 0 %>
            ¥<%= number_with_delimiter(total_month_cost) %>
          <% end %>
        </span>
      </div>
    <% end %>
  </div>
  <div class="flex gap-4 mt-3 text-xs" style="color: var(--color-text-muted);">
    <span class="flex items-center gap-1">
      <span class="inline-block w-3 h-3 rounded-sm" style="background: var(--color-primary); opacity: 0.7;"></span>チケット代
    </span>
    <span class="flex items-center gap-1">
      <span class="inline-block w-3 h-3 rounded-sm" style="background: var(--color-accent, #f59e0b); opacity: 0.7;"></span>グッズ費
    </span>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <%# 推し別統計 %>
  <div class="notebook-card">
    <h2 class="font-bold ruled-line mb-4" style="font-family: var(--font-heading);">🌟 推し別ランキング</h2>
    <% if @oshi_stats.empty? %>
      <p class="text-sm text-center py-6" style="color: var(--color-text-muted);"><%= @year %>年のデータがありません</p>
    <% else %>
      <ul class="space-y-3">
        <% @oshi_stats.each.with_index(1) do |stat, rank| %>
          <li class="flex items-center gap-3">
            <span class="text-lg font-bold w-6 shrink-0" style="color: var(--color-text-muted);">
              <%= rank == 1 ? "🥇" : rank == 2 ? "🥈" : rank == 3 ? "🥉" : "#{rank}." %>
            </span>
            <div class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= stat[:oshi].color %>;"></div>
            <span class="flex-1 text-sm font-medium"><%= stat[:oshi].name %></span>
            <div class="text-right text-xs" style="color: var(--color-text-muted);">
              <div><%= stat[:event_count] %>回参加</div>
              <% total_oshi_cost = stat[:ticket_cost] + stat[:goods_cost] %>
              <% if total_oshi_cost > 0 %>
                <div class="font-medium" style="color: var(--color-primary);">¥<%= number_with_delimiter(total_oshi_cost) %></div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%# イベント種別内訳 %>
  <div class="notebook-card">
    <h2 class="font-bold ruled-line mb-4" style="font-family: var(--font-heading);">🎫 イベント種別</h2>
    <% event_type_labels = { "live" => "ライブ", "handshake" => "握手会", "talk" => "トークイベント",
                              "online" => "オンライン", "release" => "リリースイベント", "other" => "その他" } %>
    <% if @event_type_breakdown.empty? %>
      <p class="text-sm text-center py-6" style="color: var(--color-text-muted);"><%= @year %>年のデータがありません</p>
    <% else %>
      <% max_type_count = @event_type_breakdown.values.max.to_i %>
      <ul class="space-y-3">
        <% @event_type_breakdown.sort_by { |_, v| -v }.each do |type, count| %>
          <li class="space-y-1">
            <div class="flex justify-between text-sm">
              <span><%= event_type_labels[type] || type %></span>
              <span style="color: var(--color-text-muted);"><%= count %>回</span>
            </div>
            <div class="h-2 rounded" style="background: var(--color-surface);">
              <div class="h-full rounded" style="width: <%= (count.to_f / max_type_count * 100).round(1) %>%; background: var(--color-primary); opacity: 0.6;"></div>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<%# フッターリンク %>
<div class="flex justify-center gap-4 text-sm">
  <%= link_to "← ダッシュボードへ", dashboard_path, class: "tab-seal" %>
  <%= link_to "イベント一覧", events_path, class: "tab-seal" %>
  <%= link_to "グッズ一覧", goods_path, class: "tab-seal" %>
</div>
