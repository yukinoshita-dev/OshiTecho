<div id="participation-<%= event.id %>">
  <% participation = event.participations.find { |p| p.user_id == Current.user&.id } %>

  <% if participation %>
    <div class="flex items-center gap-2 flex-wrap">
      <%# 状態バッジ %>
      <% badge = { "planning" => "📅 参加予定", "attended" => "✅ 参加済み", "cancelled" => "❌ キャンセル" %}[participation.status] %>
      <span class="stamp-badge text-xs"><%= badge %></span>

      <%# 他状態へ変更 %>
      <% [["参加済みに変更", "attended"], ["参加予定に変更", "planning"], ["キャンセル", "cancelled"]].each do |label, status| %>
        <% next if participation.status == status %>
        <%= button_to label,
              event_participations_path(event),
              params: { status: status },
              form: { data: { turbo_stream: true } },
              class: "tab-seal text-xs cursor-pointer" %>
      <% end %>

      <%# 取り消し %>
      <%= button_to "取り消し",
            event_participation_path(event, participation),
            method: :delete,
            form: { data: { turbo_stream: true } },
            class: "tab-seal text-xs cursor-pointer opacity-60 hover:opacity-100" %>
    </div>
  <% else %>
    <%= button_to "📅 参加予定に追加",
          event_participations_path(event),
          params: { status: "planning" },
          form: { data: { turbo_stream: true } },
          class: "btn-primary text-sm cursor-pointer" %>
  <% end %>
</div>
