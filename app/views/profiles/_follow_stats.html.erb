<div id="follow-stats-<%= user.id %>" class="flex gap-4 text-sm mt-2">
  <%= link_to following_user_path(user), class: "hover:underline" do %>
    <span class="font-bold"><%= user.following.count %></span>
    <span class="text-muted">フォロー中</span>
  <% end %>
  <%= link_to followers_user_path(user), class: "hover:underline" do %>
    <span class="font-bold"><%= user.followers.count %></span>
    <span class="text-muted">フォロワー</span>
  <% end %>
</div>
