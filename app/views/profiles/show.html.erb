<%= content_for :title, "#{@user.display_name.presence || @user.username} | 推し手帳" %>

<div class="max-w-2xl mx-auto">
  <%# ヘッダーカード %>
  <div class="notebook-card mb-6 flex items-start gap-5">
    <% if @user.avatar.attached? %>
      <%= image_tag @user.avatar, class: "w-20 h-20 rounded-full object-cover shrink-0", style: "border: 2px solid var(--color-border);" %>
    <% else %>
      <div class="w-20 h-20 rounded-full flex items-center justify-center text-3xl shrink-0"
           style="background: var(--color-badge-bg); border: 2px solid var(--color-border);">
        👤
      </div>
    <% end %>

    <div class="flex-1 min-w-0">
      <h1 class="text-xl font-bold" style="font-family: var(--font-heading);">
        <%= @user.display_name.presence || @user.username %>
      </h1>
      <% if @user.username.present? %>
        <p class="text-sm text-muted">@<%= @user.username %></p>
      <% end %>
      <% if @user.bio.present? %>
        <p class="mt-3 text-sm leading-relaxed"><%= simple_format(@user.bio) %></p>
      <% end %>
    </div>
  </div>

  <%# 推し一覧（今後実装）%>
  <div class="notebook-card text-center py-8">
    <p class="text-muted text-sm">推し一覧は準備中です</p>
  </div>
</div>
