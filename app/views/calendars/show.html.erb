<% content_for :title, "カレンダー | 推し手帳" %>

<%# FullCalendar CDN %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.css">
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.js"></script>
<% end %>

<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold" style="font-family: var(--font-heading);">📅 カレンダー</h1>
  <p class="text-xs" style="color: var(--color-text-muted);">自分＋FFの公開イベント・記念日を表示</p>
</div>

<%# 凡例 %>
<div class="notebook-card mb-4 flex flex-wrap gap-3 text-xs items-center">
  <div class="flex items-center gap-1">
    <span class="inline-block w-3 h-3 rounded-full" style="background: #6366f1;"></span>
    <span>自分のイベント</span>
  </div>
  <div class="flex items-center gap-1">
    <span class="inline-block w-3 h-3 rounded-full" style="background: #94a3b8;"></span>
    <span>FFのイベント</span>
  </div>
  <div class="flex items-center gap-1">
    <span class="inline-block w-3 h-3 rounded-full" style="background: #f472b6;"></span>
    <span>🎂 推しの記念日</span>
  </div>
</div>

<div class="notebook-card p-3"
     data-controller="calendar"
     data-calendar-events-url-value="<%= events_calendar_path(format: :json) %>">
  <div id="calendar-container" class="min-h-[500px]"></div>
</div>

<%# イベント詳細ポップアップ %>
<div id="calendar-popup"
     class="hidden fixed z-50 rounded-lg shadow-xl p-4 text-sm max-w-xs"
     style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);">
  <button onclick="document.getElementById('calendar-popup').classList.add('hidden')"
          class="absolute top-2 right-2 text-xs opacity-60 hover:opacity-100">✕</button>
  <p id="popup-title" class="font-bold mb-1"></p>
  <p id="popup-oshi"  class="text-xs mb-1" style="color: var(--color-text-muted);"></p>
  <p id="popup-venue" class="text-xs mb-2" style="color: var(--color-text-muted);"></p>
  <a id="popup-link" href="#" class="tab-seal text-xs hidden">詳細を見る</a>
</div>
