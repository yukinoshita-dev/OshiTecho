<%= content_for :title, "フォロワー | 推し手帳" %>

<h1 class="text-2xl font-bold mb-6" style="font-family: var(--font-heading);">
  <%= @user.display_name.presence || @user.username %> のフォロワー
</h1>

<% if @users.empty? %>
  <div class="notebook-card text-center py-8">
    <p class="text-muted text-sm">フォロワーはまだいません</p>
  </div>
<% else %>
  <div class="space-y-3">
    <% @users.each do |user| %>
      <%= render "user_card", user: user %>
    <% end %>
  </div>
<% end %>
