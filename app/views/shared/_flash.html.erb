<% flash.each do |type, message| %>
  <% bg = type.to_s == "alert" ? "bg-red-100 border-red-400 text-red-800" : "bg-green-100 border-green-400 text-green-800" %>
  <div class="border px-4 py-3 rounded mb-2 text-sm <%= bg %>"
       data-controller="flash"
       data-action="animationend->flash#remove">
    <%= message %>
  </div>
<% end %>
