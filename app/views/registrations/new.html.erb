<%= content_for :title, "新規登録 | 推し手帳" %>

<div class="max-w-md mx-auto mt-8">
  <div class="notebook-card">
    <h1 class="text-2xl font-bold mb-1 ruled-line" style="font-family: var(--font-heading);">新規登録</h1>
    <p class="text-muted text-sm mb-6">推し手帳をはじめる</p>

    <%= form_with model: @user, url: registration_path do |form| %>
      <% if @user.errors.any? %>
        <div class="mb-4 p-3 rounded text-sm" style="background: var(--color-badge-bg); color: var(--color-badge-text);">
          <% @user.errors.full_messages.each do |msg| %>
            <p>・<%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= form.label :email_address, "メールアドレス", class: "block text-sm font-medium mb-1" %>
        <%= form.email_field :email_address,
              required: true, autofocus: true, autocomplete: "email",
              placeholder: "example@example.com",
              class: "w-full px-3 py-2 rounded border text-sm",
              style: "background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);" %>
      </div>

      <div class="mb-4">
        <%= form.label :username, "ユーザー名（任意）", class: "block text-sm font-medium mb-1" %>
        <%= form.text_field :username,
              autocomplete: "username",
              placeholder: "半角英数字・アンダースコア（最大30文字）",
              class: "w-full px-3 py-2 rounded border text-sm",
              style: "background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);" %>
      </div>

      <div class="mb-4">
        <%= form.label :display_name, "表示名（任意）", class: "block text-sm font-medium mb-1" %>
        <%= form.text_field :display_name,
              placeholder: "推し活ネーム（最大50文字）",
              class: "w-full px-3 py-2 rounded border text-sm",
              style: "background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);" %>
      </div>

      <div class="mb-4">
        <%= form.label :password, "パスワード", class: "block text-sm font-medium mb-1" %>
        <%= form.password_field :password,
              required: true, autocomplete: "new-password",
              placeholder: "8文字以上",
              maxlength: 72,
              class: "w-full px-3 py-2 rounded border text-sm",
              style: "background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);" %>
      </div>

      <div class="mb-6">
        <%= form.label :password_confirmation, "パスワード（確認）", class: "block text-sm font-medium mb-1" %>
        <%= form.password_field :password_confirmation,
              required: true, autocomplete: "new-password",
              placeholder: "同じパスワードをもう一度",
              maxlength: 72,
              class: "w-full px-3 py-2 rounded border text-sm",
              style: "background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);" %>
      </div>

      <%= form.submit "登録する", class: "btn-primary cursor-pointer w-full text-center" %>
    <% end %>

    <div class="mt-6 pt-4 border-t text-sm text-center" style="border-color: var(--color-border);">
      すでにアカウントをお持ちの方は
      <%= link_to "ログイン", new_session_path, class: "text-primary font-medium underline hover:no-underline" %>
    </div>
  </div>
</div>
